{
  "name": "torbox-streamer",
  "version": "2.0.2",
  "description": "TorBox Streamer browser extension for Firefox & Waterfox",
  "main": "extension/background.js",
  "scripts": {
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest tests/unit",
    "test:e2e:mock": "playwright test tests/e2e/mock",
    "test:e2e:online": "playwright test tests/e2e/online",
    "test:e2e": "npm run test:e2e:mock",
    "test": "npm run test:unit && npm run test:e2e:mock"
  },
  "keywords": [
    "torbox",
    "browser-extension",
    "firefox",
    "stremio",
    "torrentio"
  ],
  "author": "flamprakis",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "vitest": "^2.1.8"
  }
}
